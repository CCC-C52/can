{
  "name": "ai-operations-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "worker": "tsx --tsconfig tsconfig.json worker/index.ts",
    "db:migrate": "tsx --tsconfig tsconfig.json scripts/migrate.ts",
    "db:seed-demo": "tsx --tsconfig tsconfig.json scripts/seed-demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "acceptance": "tsx --tsconfig tsconfig.json scripts/acceptance.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "jszip": "^3.10.2",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.0.5"
  }
