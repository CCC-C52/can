# =====================================================================
# AI Operations Studio — örnek ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın. Gizli değerleri ASLA depoya eklemeyin.
# Boş bırakılan servisler "Bağlı değil" olarak görünür; uygulama demo modda çalışır.
# =====================================================================

# --- Uygulama modu ---------------------------------------------------
# local      : Yalnızca 127.0.0.1 üzerinde yerel demo. Giriş isteğe bağlı.
# production : İnternete açılacak sürüm. ADMIN_PASSWORD ve SESSION_SECRET zorunlu.
APP_MODE=local
# local modda panel girişi istensin mi? (true/false)
LOCAL_REQUIRE_LOGIN=false

# --- Kimlik doğrulama ------------------------------------------------
# Yönetici parolası (production modda zorunlu, en az 12 karakter).
ADMIN_PASSWORD=
# Oturum çerezlerini imzalamak için rastgele, en az 32 karakterlik değer.
# Örnek üretim: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Bağlantı kimlik bilgilerini (OAuth belirteçleri vb.) veritabanında şifrelemek için 32 bayt (base64).
# Örnek üretim: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Veritabanı ------------------------------------------------------
DATABASE_URL=postgres://aiops:aiops@127.0.0.1:5432/aiops
# Testler bu veritabanını sıfırlar; üretim veritabanını buraya YAZMAYIN.
TEST_DATABASE_URL=postgres://aiops:aiops@127.0.0.1:5432/aiops_test

# --- Dosya depolama --------------------------------------------------
# local : ./data/storage klasörü (geliştirme)
# s3    : S3 uyumlu depolama (AWS S3, Cloudflare R2, MinIO ...)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/storage
S3_BUCKET=
S3_REGION=
# R2/MinIO gibi servisler için uç nokta (AWS S3 için boş bırakın)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Yüklenebilecek en büyük dosya (MB)
MAX_UPLOAD_MB=200

# --- Metin / planlama modeli (Anthropic Claude API) -----------------
# Claude Code aboneliği bu uygulamanın API kullanımını KARŞILAMAZ.
# Gerçek AI modu için https://console.anthropic.com üzerinden ayrı bir API anahtarı oluşturun.
# Boşsa uygulama "DEMO" etiketli kural tabanlı üreticiyle çalışır.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# --- Görsel üretimi (OpenAI Images API — isteğe bağlı) --------------
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# Görsel başına tahmini maliyet (USD). Sağlayıcının güncel fiyatına göre güncelleyin; boşsa "bilinmiyor".
OPENAI_IMAGE_COST_USD=

# --- Shopify (Admin GraphQL API) -------------------------------------
# Mağaza bağlantısı panelde Entegrasyonlar ekranından marka bazında yapılır.
# Uygulama kimlik bilgileri (Shopify Dev Dashboard'da oluşturulan uygulamanın)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10
# OAuth geri dönüş adresinin kökü (ör. https://panel.alanadiniz.com)
PUBLIC_BASE_URL=http://127.0.0.1:3000

# --- Instagram (Instagram API with Instagram Login) ------------------
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v24.0

# --- TikTok (Content Posting API — uygulama denetimi gerekir) --------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Meta reklam / performans verileri (Marketing API) ---------------
META_APP_SECRET=

# --- Video düzenleme (yerel ffmpeg) ---------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- İşleyici -------------------------------------------------------
WORKER_POLL_MS=1500
# DEMO modunda her ajan çağrısına yapay gecikme (ms). Yalnızca gösterim/test içindir.
DEMO_DELAY_MS=0
